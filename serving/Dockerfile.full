# Full image: the slim service plus the video feature extractor (POST /detect_video).
#
# Uses mmaction2 0.x itself, the code the dataset was made with. mmaction2 0.x needs mmcv-full
# 1.x, which ships CPU wheels only for older PyTorch, hence Python 3.10 + torch 1.13 here.
# Not built or tested in CI. To use the lighter torchvision port instead, set
# EXTRACTOR_BACKEND=torch (only after it passes `python -m preprocess.verify`).
#
#   docker build -f serving/Dockerfile.full -t video-event-serving-full .
#   docker run -p 8000:8000 -v $PWD/models:/app/models -v $HOME/.cache/torch:/root/.cache/torch \
#       video-event-serving-full
FROM python:3.10-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "numpy<2" torch==1.13.1 torchvision==0.14.1 \
        --extra-index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir mmcv-full==1.7.2 \
        -f https://download.openmmlab.com/mmcv/dist/cpu/torch1.13/index.html \
    && pip install --no-cache-dir mmaction2==0.24.1 \
    && pip install --no-cache-dir pydantic pyyaml fastapi "uvicorn[standard]" onnxruntime \
        python-multipart opencv-contrib-python-headless "scenedetect>=0.6.4"
COPY common ./common
COPY detection/__init__.py detection/events.py ./detection/
COPY preprocess ./preprocess
COPY serving ./serving
# The dataset's checkpoints download on first start into /root/.cache/torch (mount it to keep
# them). They hold non-tensor metadata, so loading them needs TRUST_CHECKPOINT=1; only set it
# for checkpoints from download.openmmlab.com or another source you trust.
ENV MODEL_DIR=/app/models EXTRACTOR_BACKEND=mmaction2 PYTHONUNBUFFERED=1
EXPOSE 8000
HEALTHCHECK CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8000/health')"
CMD ["uvicorn", "serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
